{
  email {$ACME_EMAIL}
  metrics
  # Error logging must not reintroduce request URLs/headers removed below.
  log default {
    format filter {
      wrap json
      fields {
        request delete
        resp_headers delete
      }
    }
  }
}
{$DOMAIN} {
  import /etc/caddy/monitor.Caddyfile
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' blob: data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    -Server
  }
  route {
    # Capture the classification before try_files rewrites private paths.
    log_append <category {kado_category}
    log_append <method {kado_method}
    log_append <navigation {kado_navigation}
    @head method HEAD
    log_skip @head
    @revalidate path / /index.html /sw.js
    header @revalidate Cache-Control "no-cache"
    @oldCounter {
      path /api/page-views
      method POST
    }
    respond @oldCounter 204
    respond /metrics 404
    @api path /api /api/* /health /health/*
    reverse_proxy @api api:3000 {
      header_up -Forwarded
      transport http {
        read_timeout 30s
        write_timeout 30s
        dial_timeout 5s
      }
    }
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
