# DNS public du service
DOMAIN=kado.example.com

# Adresse email pour Let's Encrypt (notifications expiration)
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=kado
POSTGRES_USER=kado
POSTGRES_PASSWORD=change-me-strong-password

# Optionnel: URL publique du lien de soutien integree au build frontend
VITE_DONATION_URL=https://tiptopjar.com/...
