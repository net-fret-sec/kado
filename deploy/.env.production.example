# SHA du commit fourni dans le bundle CI
IMAGE_TAG=replace-with-validated-40-character-sha

# DNS public du service
DOMAIN=kado.example.com

# Adresse email pour Let's Encrypt (notifications expiration)
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=kado
POSTGRES_USER=kado
POSTGRES_PASSWORD=change-me-strong-password

# Optionnel: URL publique du lien de soutien integree au build frontend
VITE_DONATION_URL=https://tiptopjar.com/...

# Adresse publique de contact (sans mailto:). Vide : aucun lien de contact.
# Intégrée au build frontend; reconstruire après modification.
VITE_CONTACT_EMAIL=

VITE_CURRENCY_SYMBOL=$

# Private anonymous access spool shared with the host collector (not PostgreSQL backups).
KADO_MONITOR_LOG_DIR=/var/lib/kado-monitor/access

# Textes juridiques externes (répertoire existant sur l'hôte, monté en lecture seule).
# Préparer et valider les six textes avant le démarrage : docs/LEGAL-CONTENT.md.
LEGAL_CONTENT_DIR=/var/lib/kado/legal

# Optional: independent NetFretSec gateway (Compose >= 2.24.4).
# Create the netfretsec_kado network and deploy the gateway first.
# KADO_EDGE_MODE=1
# NETFRETSEC_EDGE_CONTAINER=netfretsec-edge
# Optional explicit metrics host (also supported in standalone mode).
# KADO_METRICS_HOST=kado.example.com
