SERVER_ADDRESS=http://0.0.0.0
SERVER_PORT=3000
FRONTEND_BASE_URL="http://127.0.0.1:5173"
# Optionnel: liste d'origines autorisées pour CORS (CSV)
# Exemple: "http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_ALLOWED_ORIGINS=

# Protection anti-enumeration des liens participants (/api/p/:token)

# PostgreSQL
# Exemple: postgresql://postgres:postgres@127.0.0.1:5432/kado
DATABASE_URL=

# Civil exchange dates and automatic archiving
EXCHANGE_TIME_ZONE=America/Toronto
# Never enable in production (API also requires NODE_ENV=development)
ENABLE_LOCAL_ADMIN_TOOLS=false

# P1: validated configuration, per-process limits
TRUST_PROXY_HOPS=0
MAX_ACTIVE_PARTICIPANTS=50
DB_QUERY_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DRAW_MAX_NODES=200000
DRAW_TIMEOUT_MS=2000
RATE_LIMIT_MAX_KEYS=10000
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=300000
CREATE_RATE_LIMIT=10
CREATE_RATE_WINDOW_MS=3600000
AUTH_RATE_LIMIT=30
AUTH_PAIR_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
PARTICIPANT_RATE_LIMIT=120
PARTICIPANT_RATE_WINDOW_MS=60000
DRAW_RATE_LIMIT=5
DRAW_RATE_WINDOW_MS=60000

# Images de suggestions: octets, pixels et millisecondes; quotas incluant les images temporaires
IMAGE_SOURCE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_DIMENSION=1600
IMAGE_OUTPUT_MAX_BYTES=524288
IMAGE_PARTICIPANT_QUOTA_BYTES=10485760
IMAGE_EXCHANGE_QUOTA_BYTES=104857600
IMAGE_TOTAL_QUOTA_BYTES=2147483648
IMAGE_TEMP_TTL_MS=86400000
IMAGE_TRANSFORM_TIMEOUT_MS=5000
IMAGE_RECEIVE_TIMEOUT_MS=10000
IMAGE_UPLOAD_RATE_LIMIT=20
