# Laisser vide pour utiliser le meme host/port que le frontend (proxy Vite en dev)
VITE_API_BASE=

# Optionnel: URL publique du lien de soutien affiche sur l'accueil
VITE_DONATION_URL=

# Delai (en secondes) avant d'activer le bouton "Continuer" apres creation
VITE_ADMIN_LINK_CONTINUE_COUNTDOWN_SECONDS=5

# Explicit local-only global exchange tooling
VITE_ENABLE_LOCAL_ADMIN_TOOLS=false

# Apparence initiale (variables intégrées au build Vite).
# Redémarrer Vite après modification; reconstruire le frontend en production.
# Les sélecteurs permettent ensuite de changer ces choix dans l’interface.
# Valeur absente, vide ou invalide : polices j, palette i (direction Kado).
# Thème de polices — valeurs possibles :
# a : Lagune (Open Sans + Manrope)
# b : Sandstone (Cal Sans + Manrope)
# c : Électrique (Space Grotesk + Inter)
# d : Patrimoine (Fraunces + Manrope)
# e : Nordique (Sora + Noto Sans)
# f : Atlas (Archivo + Work Sans)
# g : Prestige (DM Serif Display + DM Sans)
# h : Circuit (Cal Sans + Inter)
# i : Nuit douce (Space Grotesk + Noto Sans)
# j : Citrus (Sora + Open Sans)
VITE_FONT_THEME=j

# Palette de couleurs — valeurs possibles :
# a : Lagune claire
# b : Sandstone éditorial
# c : Produit électrique
# d : Patrimoine serif
# e : Nordique frais
# f : Atlas structuré
# g : Contraste prestige
# h : Circuit menthe
# i : Nuit douce
# j : Citrus pop
# k : Volcan graphique
# l : Gel acide
# m : Archive solaire
# n : Aube glaciaire
# o : Noir phosphore
# p : Canopée humide
VITE_PALETTE_THEME=i

VITE_CURRENCY_SYMBOL=$
